plot(clim_dat$total_precipitation_sum_28d, clim_dat$CH4_avg)
abline(lm(clim_dat$CH4_avg ~ clim_dat$total_precipitation_sum_14d))
plot(clim_dat$CO2_avg, clim_dat$CH4_avg)
